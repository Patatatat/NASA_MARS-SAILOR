{
  "meta": {
	"schema_version": 1,
	"max_unresolved_urgent_situations": 2,
	"duplicate_policy": "merge_same_template_and_target"
  },
  "templates": [
	{
	  "id": "storm_solar_panel",
	  "priority": "urgent",
	  "target_type": "solar_panel",
	  "trigger": {
		"active_event": "dust_storm",
		"building_condition": "exposed_to_storm"
	  },
	  "time_response": "force_x0_5",
	  "inaction_behavior": "risk_continues",
	  "title_key": "decision.storm_solar_panel.title",
	  "condition_key": "decision.storm_solar_panel.condition",
	  "options": [
		{
		  "id": "retract",
		  "service_command": "BuildingService.set_storm_protection",
		  "arguments": { "enabled": true },
		  "cost_preview_key": "decision.storm_solar_panel.retract.cost",
		  "tradeoff_key": "decision.storm_solar_panel.retract.tradeoff"
		},
		{
		  "id": "keep_deployed",
		  "service_command": "BuildingService.set_storm_protection",
		  "arguments": { "enabled": false },
		  "cost_preview_key": "decision.storm_solar_panel.keep.cost",
		  "tradeoff_key": "decision.storm_solar_panel.keep.tradeoff"
		}
	  ]
	},
	{
	  "id": "flare_outside_repair",
	  "priority": "critical",
	  "target_type": "repair_target",
	  "trigger": {
		"active_event": "solar_flare",
		"pending_task": "outside_repair"
	  },
	  "time_response": "pause",
	  "inaction_behavior": "risk_continues",
	  "title_key": "decision.flare_repair.title",
	  "condition_key": "decision.flare_repair.condition",
	  "options": [
		{
		  "id": "shelter",
		  "service_command": "CrewService.order_shelter",
		  "arguments": {},
		  "cost_preview_key": "decision.flare_repair.shelter.cost",
		  "tradeoff_key": "decision.flare_repair.shelter.tradeoff"
		},
		{
		  "id": "send_eva",
		  "service_command": "CrewService.assign_eva_repair",
		  "arguments": {},
		  "cost_preview_key": "decision.flare_repair.eva.cost",
		  "tradeoff_key": "decision.flare_repair.eva.tradeoff"
		}
	  ]
	},
	{
	  "id": "night_battery_shortage",
	  "priority": "urgent",
	  "target_type": "powered_building",
	  "trigger": {
		"time_phase": "night",
		"battery_condition": "below_emergency_reserve"
	  },
	  "time_response": "force_x0_5",
	  "inaction_behavior": "risk_continues",
	  "title_key": "decision.night_battery.title",
	  "condition_key": "decision.night_battery.condition",
	  "options": [
		{
		  "id": "cut_target_power",
		  "service_command": "BuildingService.set_enabled",
		  "arguments": { "enabled": false },
		  "cost_preview_key": "decision.night_battery.cut.cost",
		  "tradeoff_key": "decision.night_battery.cut.tradeoff"
		},
		{
		  "id": "keep_target_power",
		  "service_command": "BuildingService.set_enabled",
		  "arguments": { "enabled": true },
		  "cost_preview_key": "decision.night_battery.keep.cost",
		  "tradeoff_key": "decision.night_battery.keep.tradeoff"
		}
	  ]
	}
  ]
}
