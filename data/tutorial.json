{
  "meta": { "schema_version": 1 },
  "settings": {
	"ambient_min_interval_sols": 1,
	"max_ambient_entries_per_sol": 1,
	"critical_requires_acknowledgement": true,
	"allow_skip": true,
	"allow_reactivate_from_settings_or_codex": true
  },
  "steps": [
	{
	  "id": "first_night",
	  "trigger": { "type": "building_placed", "building_id": "solar_panel" },
	  "priority": "tutorial",
	  "title_key": "tutorial.first_night.title",
	  "body_key": "tutorial.first_night.body",
	  "focus_target": "ui:time_controls",
	  "completion": "dismiss"
	},
	{
	  "id": "laboratory",
	  "trigger": { "type": "sol_started", "sol": 1 },
	  "priority": "tutorial",
	  "title_key": "tutorial.lab.title",
	  "body_key": "tutorial.lab.body",
	  "focus_target": "ui:workspace_build",
	  "completion": "building_placed:laboratory"
	},
	{
	  "id": "solar_research",
	  "trigger": { "type": "research_completed", "tech_id": "solar_panel" },
	  "priority": "tutorial",
	  "title_key": "tutorial.solar.title",
	  "body_key": "tutorial.solar.body",
	  "focus_target": "ui:workspace_build",
	  "completion": "building_placed:solar_panel"
	},
	{
	  "id": "satellite_scan",
	  "trigger": { "type": "research_completed", "tech_id": "satellite_scan" },
	  "priority": "tutorial",
	  "title_key": "tutorial.scan.title",
	  "body_key": "tutorial.scan.body",
	  "focus_target": "world:scan_sector",
	  "completion": "dismiss"
	},
	{
	  "id": "rocket_manifest",
	  "trigger": { "type": "sol_started", "sol": 6 },
	  "priority": "tutorial",
	  "title_key": "tutorial.rocket.title",
	  "body_key": "tutorial.rocket.body",
	  "focus_target": "ui:workspace_rocket",
	  "completion": "dismiss"
	},
	{
	  "id": "solar_flare",
	  "trigger": { "type": "event_warning", "event_id": "solar_flare" },
	  "priority": "tutorial",
	  "title_key": "tutorial.radiation.title",
	  "body_key": "tutorial.radiation.body",
	  "focus_target": "ui:workspace_crew",
	  "completion": "dismiss"
	}
  ],
  "ambient_pools": {
	"astronaut_thought": ["ambient.thought.1", "ambient.thought.2"],
	"science_fact": ["ambient.science.1", "ambient.science.2"]
  }
}
